# OS / editor cruft
.DS_Store
*.log

# Local agent config (Claude Code) — not needed for hosting
.claude/
**/.claude/

# Node
node_modules/

# Larprady: raw source data — build-time only. The live game runs on the
# generated boards.json / categories.json (which ARE committed). Keep a copy
# of this CSV somewhere safe if you ever want to re-run build_boards.py.
jeoprady/JEOPARDY_CSV.csv

# Drawing canvas runtime state (server-side, not source)
draw/canvas.bin
draw/canvas.bin.tmp

# Jigsaw runtime state (lives in /var/lib/kmufti-puzzle in production, but a
# local dev run writes it here).
puzzle/table.json
puzzle/shelf.json
puzzle/*.tmp

# Jigsaw backend also keeps the hub visit count (prod: /var/lib/kmufti-puzzle).
puzzle/visits.json

# Cached practice photos for Meccha Chameleon (prod: /var/lib/kmufti-chameleon).
chameleon/photos/

# Meccha Chameleon: rounds flagged while playing, and the photos they kept
# (prod: /var/lib/kmufti-chameleon/verdicts).
chameleon/verdicts/

# The ops dashboard keeps its uptime/traffic history here on a laptop run
# (prod: /var/lib/kmufti-admin).
admin/state/

# Infinite Kitchen: untried-pair list from a laptop run
# (prod: /var/lib/kmufti-kitchen).
infinite-kitchen/data/

# Infinite Kitchen: the old recipe set, kept aside locally until it is deleted.
infinite-kitchen/_archive/
infinite-kitchen/_lab/
